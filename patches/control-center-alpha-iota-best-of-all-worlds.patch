diff --git a/tools/control_center_phase_report.py b/tools/control_center_phase_report.py
new file mode 100755
index 0000000..53a279f
--- /dev/null
+++ b/tools/control_center_phase_report.py
@@ -0,0 +1,49 @@
+#!/usr/bin/env python3
+"""Validate Control Center alpha-iota phase artifacts without touching engine/Wine paths."""
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+PHASES = [
+    ("alpha", "27-control-center-phase-alpha-audit.md"),
+    ("beta", "28-phase-beta-library.md"),
+    ("gamma", "29-phase-gamma-bottles.md"),
+    ("delta", "30-phase-delta-profiles.md"),
+    ("epsilon", "31-phase-epsilon-hud.md"),
+    ("zeta", "32-phase-zeta-ai-diagnose.md"),
+    ("eta", "33-phase-eta-polish.md"),
+    ("theta", "34-phase-theta-onboarding.md"),
+    ("iota", "35-phase-iota-packaging.md"),
+]
+
+
+def exists(path: Path) -> bool:
+    return path.exists() and path.stat().st_size > 0
+
+
+def main() -> int:
+    rows = []
+    ok = True
+    for phase, vault in PHASES:
+        status = ROOT / "docs" / f"STATUS-control-center-phase-{phase}.md"
+        vault_path = ROOT / "tools" / "vault" / vault
+        phase_ok = exists(status) and exists(vault_path)
+        rows.append({"phase": phase, "status": str(status.relative_to(ROOT)), "vault": str(vault_path.relative_to(ROOT)), "ok": phase_ok})
+        ok = ok and phase_ok
+
+    payload = {
+        "schema_version": 1,
+        "root": str(ROOT),
+        "allowed_scope": ["app/macr-control-center", "profiles", "config", "docs/STATUS-control-center-*", "tools"],
+        "protected_scope": ["engine", "wine-fork", "scripts/build-wine.sh", "scripts/sign-engine.sh", "scripts/loop-wineboot.sh"],
+        "phases": rows,
+        "ok": ok,
+    }
+    print(json.dumps(payload, indent=2, sort_keys=True))
+    return 0 if ok else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
