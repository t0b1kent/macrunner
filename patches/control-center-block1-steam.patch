diff --git a/app/macr-control-center/Sources/MacRunnerControlCenter/Services/Library/Steam/SteamVDFParser.swift b/app/macr-control-center/Sources/MacRunnerControlCenter/Services/Library/Steam/SteamVDFParser.swift
