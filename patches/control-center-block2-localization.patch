diff --git a/tools/lint-localization.swift b/tools/lint-localization.swift
new file mode 100755
index 0000000..06e7a6c
--- /dev/null
+++ b/tools/lint-localization.swift
@@ -0,0 +1,22 @@
+#!/usr/bin/env swift
+import Foundation
+
+let root = URL(fileURLWithPath: FileManager.default.currentDirectoryPath)
+let resources = root.appendingPathComponent("app/macr-control-center/Sources/MacRunnerControlCenter/Resources")
+let langs = ["en", "ru"]
+func keys(for lang: String) -> Set<String> {
+    let url = resources.appendingPathComponent("\(lang).lproj/Localizable.strings")
+    guard let dict = NSDictionary(contentsOf: url) as? [String: String] else { return [] }
+    return Set(dict.keys)
+}
+let all = langs.map { ($0, keys(for: $0)) }
+let baseline = all.first?.1 ?? []
+var ok = true
+for (lang, keys) in all {
+    let missing = baseline.subtracting(keys)
+    if !missing.isEmpty {
+        ok = false
+        print("missing \(lang): \(missing.sorted().joined(separator: ", "))")
+    }
+}
+exit(ok ? 0 : 1)
