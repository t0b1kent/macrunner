+        __atomic_store_n( &macrunner_hb_item_host_probe_ready_us, now_us, __ATOMIC_RELAXED );
+        __atomic_store_n( &macrunner_hb_item_host_probe_ready_mem, (uintptr_t)ctx->memory, __ATOMIC_RELAXED );
