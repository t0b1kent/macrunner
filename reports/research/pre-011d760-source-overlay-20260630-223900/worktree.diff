+    if (after_ready)
+    {
+        if (post_ready_reports < 500)
+        {
+            should_log = 1;
+            post_ready_reports++;
+        }
+    }
+    else if (!strcmp( role, "producer" ))
+        should_log = 1;
+    else if (pre_ready_reports < 160 || !(pre_ready_reports & 0x3ff))
+    {
+        should_log = 1;
+        pre_ready_reports++;
