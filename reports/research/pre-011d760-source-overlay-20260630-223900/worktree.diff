+TEST(memory_live_sync_exec_covers_adjacent_regions) {
+    const size_t page = 4096;
+    uint8_t* backing = mmap(NULL, page * 2, PROT_READ | PROT_WRITE,
+                            MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    ASSERT(backing != MAP_FAILED);
+
+    hb_memory_t* mem = hb_memory_create(0);
+    ASSERT(mem != NULL);
+    ASSERT(hb_memory_map(mem, (hb_gva_t)(uintptr_t)backing, page,
+                         HB_PERM_READ | HB_PERM_WRITE) == HB_OK);
+    ASSERT(hb_memory_map(mem, (hb_gva_t)(uintptr_t)(backing + page), page,
+                         HB_PERM_READ | HB_PERM_WRITE) == HB_OK);
+
+    ASSERT(hb_memory_sync_live_range(mem, (hb_gva_t)(uintptr_t)backing, page * 2,
+                                     HB_PERM_READ | HB_PERM_EXEC) == HB_OK);
+    ASSERT(hb_memory_can_exec(mem, (hb_gva_t)(uintptr_t)backing, page));
+    ASSERT(hb_memory_can_exec(mem, (hb_gva_t)(uintptr_t)(backing + page), page));
+
+    hb_memory_destroy(mem);
+    munmap(backing, page * 2);
+    tests_passed++;
+}
+
+TEST(memory_live_sync_exec_fills_unmapped_tail) {
+    const hb_gva_t base = 0x167600000ULL;
+    const size_t page = 4096;
+    hb_memory_t* mem = hb_memory_create(0);
+    ASSERT(mem != NULL);
+
+    /* Reproduces the Mono failure: replay found a live prefix at allocation
+     * base, while the target at +0x43eb had no HB region at all. */
+    ASSERT(hb_memory_map(mem, base, page, HB_PERM_READ | HB_PERM_WRITE) == HB_OK);
+    ASSERT(hb_memory_find_region(mem, base + 0x43eb) == NULL);
+    ASSERT(hb_memory_sync_live_range(mem, base, 0x10000,
+                                     HB_PERM_READ | HB_PERM_WRITE | HB_PERM_EXEC) == HB_OK);
+    ASSERT(hb_memory_can_exec(mem, base, 0x10000));
+    ASSERT(hb_memory_find_region(mem, base + 0x43eb) != NULL);
+    ASSERT(hb_memory_find_region(mem, base + 0x43eb)->perm & HB_PERM_EXEC);
+
+    hb_memory_destroy(mem);
+    tests_passed++;
+}
+
+TEST(memory_live_sync_exec_preserves_outside_fragments) {
+    const hb_gva_t base = 0x240000000ULL;
+    const size_t page = 4096;
+    hb_memory_t* mem = hb_memory_create(0);
+    ASSERT(mem != NULL);
+    ASSERT(hb_memory_map(mem, base, page * 3,
+                         HB_PERM_READ | HB_PERM_WRITE) == HB_OK);
+
+    ASSERT(hb_memory_sync_live_range(mem, base + page, page,
+                                     HB_PERM_READ | HB_PERM_EXEC) == HB_OK);
+    ASSERT(!(hb_memory_find_region(mem, base)->perm & HB_PERM_EXEC));
+    ASSERT(hb_memory_find_region(mem, base + page)->perm & HB_PERM_EXEC);
+    ASSERT(!(hb_memory_find_region(mem, base + page * 2)->perm & HB_PERM_EXEC));
+    ASSERT(hb_memory_find_region(mem, base)->perm & HB_PERM_WRITE);
+    ASSERT(hb_memory_find_region(mem, base + page * 2)->perm & HB_PERM_WRITE);
+
+    hb_memory_destroy(mem);
+    tests_passed++;
+}
