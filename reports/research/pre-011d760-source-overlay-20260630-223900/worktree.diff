+static uint64_t macrunner_hb_trace_read_u64_or_zero( hb_context_t *ctx, uint64_t addr )
+{
+    uint64_t value = 0;
+
+    if (!ctx || !ctx->memory || !addr) return 0;
+    hb_memory_read_u64( ctx->memory, addr, &value );
+    return value;
+}
