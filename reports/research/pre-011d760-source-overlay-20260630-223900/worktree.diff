+            macrunner_hb_get_export_module_name( mod, modname, sizeof(modname) );
+            rva = frames[i] - (uint64_t)(uintptr_t)mod;
+        }
+        fprintf( stderr, "  #%02d %p %s+0x%llx\n",
+                 i, (void *)(uintptr_t)frames[i], modname,
+                 (unsigned long long)rva );
+    }
+    stack_n++;
+    fflush( stderr );
+}
