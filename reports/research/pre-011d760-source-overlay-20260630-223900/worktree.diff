+    void *host_r = NULL, *host_rw = NULL;
+    hb_region_t *region = NULL;
+    struct macrunner_hb_virtual_region record = { 0 };
+    uint32_t hb_value = 0, host_value = 0;
+    unsigned int ok = 0, record_count = 0;
+    BOOL record_found = FALSE;
