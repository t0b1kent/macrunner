+             (unsigned long long)mgr, (unsigned long long)item, item40,
+             (unsigned long long)ctx->regs.x64.rax, (unsigned long long)ctx->regs.x64.rbx,
+             (unsigned long long)ctx->regs.x64.rcx, (unsigned long long)ctx->regs.x64.rdx,
