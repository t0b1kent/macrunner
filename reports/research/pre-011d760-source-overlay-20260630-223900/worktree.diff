+    case 0x586ca0: site = "producer-entry"; role = "producer"; break;
+    case 0x586caf: site = "producer-after-promote"; role = "producer"; break;
+    case 0x586cf8: site = "producer-vfunc80-gate"; role = "producer"; break;
