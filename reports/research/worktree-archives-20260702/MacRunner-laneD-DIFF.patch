+    def _fog_factor(self, state: RenderState, depth: float) -> float:
+        fog = self._fog_state(state)
+        if not fog.get("enabled", False):
+            return 1.0
+        mode = str(fog.get("mode", "D3DFOG_LINEAR"))
+        if mode == "D3DFOG_NONE":
+            return 1.0
+        if mode == "D3DFOG_EXP":
+            return max(0.0, min(1.0, math.exp(-float(fog.get("density", 1.0)) * depth)))
+        if mode == "D3DFOG_EXP2":
+            density = float(fog.get("density", 1.0))
+            value = density * depth
+            return max(0.0, min(1.0, math.exp(-(value * value))))
+        start = max(0.0, float(fog.get("start", 0.0)))
+        end = max(start + 1e-6, float(fog.get("end", 1.0)))
+        return max(0.0, min(1.0, (end - depth) / (end - start)))
+
