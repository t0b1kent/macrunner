+    def _fog_state(self, state: RenderState) -> dict:
+        ffp = state.pipeline.metadata.get("d3d9_ffp_shader", {})
+        fog = ffp.get("fog", {})
+        if not isinstance(fog, dict):
+            return {}
+        return {
+            "enabled": bool(fog.get("enabled", False)),
+            "mode": self._parse_fog_mode(fog.get("mode", "D3DFOG_LINEAR")),
+            "start": float(fog.get("start", 0.0)),
+            "end": float(fog.get("end", 1.0)),
+            "density": float(fog.get("density", 1.0)),
+            "color": _color_to_u8(fog.get("color", (255, 255, 255, 255))),
+        }
